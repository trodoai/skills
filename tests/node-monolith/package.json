{
  "name": "node-monolith-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Node monolith with several distinct agents; an un-instrumented target for tracing skills.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "mock:openai": "node mock/openai-mock.js",
    "mock:ingest": "node mock/trodo-ingest-mock.js",
