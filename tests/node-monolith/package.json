    "check": "node scripts/check-traces.js",
    "backfill": "node scripts/backfill.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.21.0",
    "openai": "^4.77.0",
    "uuid": "^11.0.0"
  }
}
